{
    "name": "nash-alumni/platform",
    "type": "project",
    "description": "Nanupur Abu Sobhan High School Alumni Association & 85th Reunion Platform - Production cPanel Distribution",
    "keywords": ["alumni", "reunion", "cpanel", "laravel", "nashalumni"],
    "license": "proprietary",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
